# ─── MAPS platform configuration ─────────────────────────────────────────────
# Copy to .env.local for development. In Railway, set these as service
# variables. Never commit real values. The app validates these at startup and
# refuses dev-only adapters when APP_ENV is staging/production.

# development | test | staging | production
APP_ENV=development
# Public base URL, used in email links. https:// required in staging/production.
APP_URL=http://localhost:3000

# Postgres (Supabase: Project Settings → Database → Connection string, "Session pooler" URI)
DATABASE_URL=postgres://postgres@localhost:5432/maps_dev
# require for Supabase/Railway hosted Postgres; disable for local
DATABASE_SSL=disable

# Authentication: supabase (production) | local (development/tests only)
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# File storage: supabase (production, PRIVATE bucket) | local (development only)
STORAGE_PROVIDER=local
SUPABASE_STORAGE_BUCKET=weekly-resources
LOCAL_STORAGE_DIR=.data/uploads
MAX_UPLOAD_MIB=20

# Email: resend (staging/production) | log (development: writes to .data/mail, never "sent")
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Signing secret of the Resend webhook endpoint (https://APP_URL/api/webhooks/resend)
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="MAPS Combinator <no-reply@your-verified-domain.org>"
EMAIL_REPLY_TO=
# Comma-separated test inboxes. When set, ONLY these receive real email;
# everything else is recorded as "Not sent (sandbox)". Leave empty in production.
EMAIL_SANDBOX_ALLOWLIST=

# Bootstrap (scripts/bootstrap-owner.ts)
OWNER_EMAIL=abdulazeezidris28@gmail.com
ORGANIZATION_NAME=MAPS Combinator

# Run the outbox/slot worker inside the web process (single Railway service).
RUN_WORKER_IN_PROCESS=true

# AI form assistant (optional). Text typed into the assistant is sent to
# Anthropic to draft form content; nothing is saved or sent until a person
# reviews the draft and presses the form's own Save/Send button.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Assistant requests per person per hour
AI_HOURLY_LIMIT=40
